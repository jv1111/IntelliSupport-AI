POSTGRES_USER=intellisupport_ai
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=intellisupport_ai
DATABASE_URL="postgresql://intellisupport_ai:replace-with-a-strong-local-password@localhost:5434/intellisupport_ai?schema=public"

GCS_BUCKET_NAME=replace-with-your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=IntelliSupport AI

UNISMS_API_KEY=your_api_key
UNISMS_SENDER_ID=your_sender_id

GEMINI_API_KEY=your_api_key

GEMINI_MODEL="gemini-3.8-flash"
