generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  published
  draft
  archived
}

enum ArticleScope {
  generic
  specific
}

enum ArticleCategoryTag {
  troubleshooting
  installation_setup
  others
}

model User {
  id                         String                      @id @default(cuid())
  username                   String                      @unique @db.VarChar(50)
  passwordHash               String                      @db.VarChar(255)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  sessions                   Session[]
  products                   Product[]
  knowledgeBaseArticles      KnowledgeBaseArticle[]
  emails                     UserEmail[]
  unverifiedEmails           UnverifiedEmail[]
  phones                     UserPhone[]
  unverifiedPhones           UnverifiedPhone[]
  passwordResetVerifications PasswordResetVerification[]
  botSettings                BotSettings?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String
  sku                   String                 @default("Not specified")
  status                ProductStatus          @default(draft)
  imageUrl              String?
  description           String                 @default("No description provided.")
  userId                String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoReplies           AutoReply[]
  knowledgeBaseArticles KnowledgeBaseArticle[]

  @@index([userId])
  @@map("products")
}

model BotSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  aiEnabled          Boolean  @default(true)
  autoRepliesEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bot_settings")
}

model AutoReply {
  id        String   @id @default(cuid())
  productId String
  parentId  String?
  question  String
  answer    String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  parent    AutoReply?  @relation("AutoReplyTree", fields: [productId, parentId], references: [productId, id], onDelete: Cascade)
  followUps AutoReply[] @relation("AutoReplyTree")

  @@unique([productId, id])
  @@index([productId, parentId, position])
  @@map("auto_replies")
}

model KnowledgeBaseArticle {
  id          String             @id @default(cuid())
  scope       ArticleScope
  categoryTag ArticleCategoryTag
  status      ProductStatus      @default(draft)
  title       String
  context     String
  productId   String?
  userId      String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([productId])
  @@map("knowledge_base_articles")
}

model UserEmail {
  id         String   @id @default(cuid())
  email      String   @unique @db.VarChar(254)
  userId     String
  verifiedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_emails")
}

model UnverifiedEmail {
  id                   String   @id @default(cuid())
  email                String   @db.VarChar(254)
  verificationCodeHash String   @db.VarChar(255)
  expiresAt            DateTime
  userId               String
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email])
  @@index([expiresAt])
  @@map("unverified_emails")
}

model UserPhone {
  id         String   @id @default(cuid())
  phone      String   @unique @db.VarChar(16)
  userId     String
  verifiedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_phones")
}

model UnverifiedPhone {
  id                   String   @id @default(cuid())
  phone                String   @db.VarChar(16)
  verificationCodeHash String   @db.VarChar(255)
  expiresAt            DateTime
  userId               String
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phone])
  @@index([expiresAt])
  @@map("unverified_phones")
}

model PasswordResetVerification {
  id                   String    @id @default(cuid())
  userId               String
  method               String    @db.VarChar(16)
  destination          String    @db.VarChar(254)
  verificationCodeHash String    @db.VarChar(255)
  expiresAt            DateTime
  verifiedAt           DateTime?
  resetTokenHash       String?   @unique @db.VarChar(64)
  resetTokenExpiresAt  DateTime?
  consumedAt           DateTime?
  createdAt            DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, method, destination])
  @@index([expiresAt])
  @@index([resetTokenExpiresAt])
  @@map("password_reset_verifications")
}
