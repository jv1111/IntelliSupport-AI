generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  published
  draft
  archived
}

enum ArticleScope {
  generic
  specific
}

enum ArticleCategoryTag {
  troubleshooting
  installation_setup
  others
}

model User {
  id                    String                 @id @default(cuid())
  username              String                 @unique @db.VarChar(50)
  passwordHash          String                 @db.VarChar(255)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  products              Product[]
  knowledgeBaseArticles KnowledgeBaseArticle[]
  emails                UserEmail[]
  unverifiedEmails      UnverifiedEmail[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Product {
  id          String        @id @default(cuid())
  name        String
  sku         String        @default("Not specified")
  status      ProductStatus @default(draft)
  imageUrl    String?
  description String        @default("No description provided.")
  userId      String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("products")
}

model KnowledgeBaseArticle {
  id          String             @id @default(cuid())
  scope       ArticleScope
  categoryTag ArticleCategoryTag
  status      ProductStatus      @default(draft)
  title       String
  context     String
  userId      String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("knowledge_base_articles")
}

model UserEmail {
  id         String   @id @default(cuid())
  email      String   @unique @db.VarChar(254)
  userId     String
  verifiedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_emails")
}

model UnverifiedEmail {
  id                   String   @id @default(cuid())
  email                String   @db.VarChar(254)
  verificationCodeHash String   @db.VarChar(255)
  expiresAt            DateTime
  userId               String
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email])
  @@index([expiresAt])
  @@map("unverified_emails")
}
