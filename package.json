    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "formik": "2.4.9",
    "graphql": "16.15.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
